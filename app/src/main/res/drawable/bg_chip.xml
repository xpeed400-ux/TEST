<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#33E0A83C"/>
            <corners android:radius="@dimen/radius_chip"/>
            <stroke android:width="1dp" android:color="@color/procam_amber"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_glass_soft"/>
            <corners android:radius="@dimen/radius_chip"/>
            <stroke android:width="1dp" android:color="@color/hud_outline"/>
        </shape>
    </item>
</selector>
