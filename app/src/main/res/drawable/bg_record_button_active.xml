<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="3dp" android:color="@color/procam_red"/>
        </shape>
    </item>
    <!-- red square (stop state) -->
    <item
        android:top="22dp" android:bottom="22dp"
        android:left="22dp" android:right="22dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/procam_red"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
</layer-list>
