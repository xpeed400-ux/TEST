<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true"
    android:fitsSystemWindows="false">

    <!-- ============ CAMERA PREVIEW ============ -->
    <SurfaceView
        android:id="@+id/previewSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.procam.s23fe.ui.widgets.RuleOfThirdsView
        android:id="@+id/grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/previewSurface"
        app:layout_constraintEnd_toEndOf="@id/previewSurface"
        app:layout_constraintTop_toTopOf="@id/previewSurface"
        app:layout_constraintBottom_toBottomOf="@id/previewSurface"/>

    <com.procam.s23fe.ui.widgets.AfTargetView
        android:id="@+id/afTarget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/previewSurface"
        app:layout_constraintEnd_toEndOf="@id/previewSurface"
        app:layout_constraintTop_toTopOf="@id/previewSurface"
        app:layout_constraintBottom_toBottomOf="@id/previewSurface"/>

    <!-- ============ TOP BAR (center, pill) ============ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/recordingDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/rec_dot"
            android:layout_marginEnd="@dimen/space_sm"
            android:visibility="invisible"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/txtTimer"
            style="@style/Hud.Timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_md"
            android:text="00:00"
            android:visibility="gone"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/txtProfile"
            style="@style/Hud.ValueLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FHD 60"/>

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="@dimen/space_md"
            android:background="@color/hud_outline_strong"/>

        <TextView
            android:id="@+id/txtBitrate"
            style="@style/Hud.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100Mbps"/>

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="@dimen/space_md"
            android:background="@color/hud_outline_strong"/>

        <TextView
            android:id="@+id/txtThermal"
            style="@style/Hud.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="T0"/>
    </LinearLayout>

    <!-- ============ HISTOGRAM (top-right) ============ -->
    <com.procam.s23fe.ui.widgets.HistogramView
        android:id="@+id/histogram"
        android:layout_width="160dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:background="@drawable/bg_glass_soft"
        android:padding="@dimen/space_xs"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ============ LEFT VERTICAL STRIP (AE/WB presets + stabilization) ============ -->
    <LinearLayout
        android:id="@+id/leftStrip"
        android:layout_width="@dimen/hud_strip_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_glass"
        android:paddingVertical="@dimen/space_md"
        android:layout_marginStart="@dimen/space_md"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AE"/>
        <TextView
            android:id="@+id/btnAePreset"
            style="@style/Hud.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_xs"
            android:paddingVertical="@dimen/space_sm"
            android:text="Daylight"
            android:clickable="true"
            android:focusable="true"/>

        <View android:layout_width="40dp" android:layout_height="1dp" android:layout_marginVertical="@dimen/space_sm" android:background="@color/hud_outline"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WB"/>
        <TextView
            android:id="@+id/btnWbPreset"
            style="@style/Hud.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_xs"
            android:paddingVertical="@dimen/space_sm"
            android:text="Daylight"
            android:clickable="true"
            android:focusable="true"/>

        <View android:layout_width="40dp" android:layout_height="1dp" android:layout_marginVertical="@dimen/space_sm" android:background="@color/hud_outline"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EIS"/>
        <TextView
            android:id="@+id/btnEisCrop"
            style="@style/Hud.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_xs"
            android:paddingVertical="@dimen/space_sm"
            android:text="20%"
            android:clickable="true"
            android:focusable="true"/>

        <View android:layout_width="40dp" android:layout_height="1dp" android:layout_marginVertical="@dimen/space_sm" android:background="@color/hud_outline"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LUT"/>
        <TextView
            android:id="@+id/txtLut"
            style="@style/Hud.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_xs"
            android:paddingVertical="@dimen/space_sm"
            android:text="None"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/procam_amber"/>
    </LinearLayout>

    <!-- ============ RIGHT VERTICAL HUD (live metering readouts) ============ -->
    <LinearLayout
        android:id="@+id/rightStrip"
        android:layout_width="@dimen/hud_strip_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_glass"
        android:paddingVertical="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/histogram"
        android:layout_marginTop="@dimen/space_md">

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ISO"/>
        <TextView android:id="@+id/txtIso"
            style="@style/Hud.Value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_xs" android:text="100"/>

        <View android:layout_width="40dp" android:layout_height="1dp" android:layout_marginVertical="@dimen/space_sm" android:background="@color/hud_outline"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHUTTER"/>
        <TextView android:id="@+id/txtShutter"
            style="@style/Hud.Value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_xs" android:text="1/120"/>

        <View android:layout_width="40dp" android:layout_height="1dp" android:layout_marginVertical="@dimen/space_sm" android:background="@color/hud_outline"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EV"/>
        <TextView android:id="@+id/txtEv"
            style="@style/Hud.Value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_xs" android:text="0"/>

        <View android:layout_width="40dp" android:layout_height="1dp" android:layout_marginVertical="@dimen/space_sm" android:background="@color/hud_outline"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FOCUS"/>
        <TextView android:id="@+id/txtFocus"
            style="@style/Hud.Value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_xs" android:text="AF"/>

        <View android:layout_width="40dp" android:layout_height="1dp" android:layout_marginVertical="@dimen/space_sm" android:background="@color/hud_outline"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FPS"/>
        <TextView android:id="@+id/txtFps"
            style="@style/Hud.Value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_xs" android:text="60"/>

        <TextView android:id="@+id/txtStab"
            style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_sm" android:text="EIS"
            android:textColor="@color/procam_teal"/>
    </LinearLayout>

    <!-- ============ MANUAL SLIDER PANEL (collapsible) ============ -->
    <LinearLayout
        android:id="@+id/manualPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_md"
        android:layout_marginHorizontal="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toEndOf="@id/leftStrip"
        app:layout_constraintEnd_toStartOf="@id/rightStrip"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ISO"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderIso"
            style="@style/ProCamSlider"
            android:valueFrom="0" android:valueTo="3200" android:stepSize="50" android:value="0"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHUTTER (1/x)"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderShutter"
            style="@style/ProCamSlider"
            android:valueFrom="0" android:valueTo="8000" android:stepSize="1" android:value="0"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FOCUS (diopters)"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderFocus"
            style="@style/ProCamSlider"
            android:valueFrom="0.0" android:valueTo="10.0" android:stepSize="0.1" android:value="0.0"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EV"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderEv"
            style="@style/ProCamSlider"
            android:valueFrom="-12" android:valueTo="12" android:stepSize="1" android:value="0"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WB (Kelvin)"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderWb"
            style="@style/ProCamSlider"
            android:valueFrom="0" android:valueTo="10000" android:stepSize="100" android:value="0"/>

        <TextView style="@style/Hud.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LUT INTENSITY"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderLutIntensity"
            style="@style/ProCamSlider"
            android:valueFrom="0" android:valueTo="100" android:stepSize="1" android:value="100"/>
    </LinearLayout>

    <!-- ============ BOTTOM BAR (profile | RECORD | toggle-manual) ============ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/space_lg"
        android:paddingHorizontal="@dimen/space_xl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnProfile"
            style="@style/Hud.Chip"
            android:text="FHD 60"/>

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <View
            android:id="@+id/btnRecord"
            style="@style/Hud.RecordButton"/>

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/btnToggleManual"
            style="@style/Hud.Chip"
            android:text="PRO"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
