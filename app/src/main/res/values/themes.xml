<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ProCam" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/procam_red</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">@color/procam_amber</item>
        <item name="colorSurface">#FF0B0C0E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ProCam.Fullscreen" parent="Theme.ProCam">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <!-- ===================== TYPOGRAPHY ===================== -->

    <style name="Hud.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/hud_text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Hud.Value" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/hud_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Hud.ValueLarge" parent="Hud.Value">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Hud.Timer" parent="Hud.Value">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/procam_red</item>
    </style>

    <!-- ===================== CHIP / BUTTONS ===================== -->

    <style name="Hud.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/hud_chip_height</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textAppearance">@style/Hud.Value</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Hud.RecordButton">
        <item name="android:layout_width">@dimen/hud_record_size</item>
        <item name="android:layout_height">@dimen/hud_record_size</item>
        <item name="android:background">@drawable/bg_record_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ProCamSlider" parent="Widget.Material3.Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="trackColorActive">@color/procam_amber</item>
        <item name="trackColorInactive">#33FFFFFF</item>
        <item name="thumbColor">@color/hud_text_primary</item>
        <item name="haloColor">#33E0A83C</item>
    </style>

</resources>
